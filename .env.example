# Which model provider to use: mock | openai | anthropic | gemini
# "mock" streams a canned reply and needs no API key.
LLM_PROVIDER=mock

# Optional: override the provider's default model
# LLM_MODEL=

# API key for the provider you picked
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Only for Anthropic keys that aren't scoped to a workspace
# ANTHROPIC_WORKSPACE_ID=

# Optional tuning
# MAX_OUTPUT_TOKENS=1024
# REQUEST_TIMEOUT_SECONDS=60
# MAX_HISTORY_CHARS=24000
# MAX_MESSAGE_CHARS=8000
# SYSTEM_PROMPT_FILE=system_prompt.txt
